{
  "name": "screen-guard",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client --port 8081",
    "android": "expo run:android --port 8081",
    "android:bundle": "node -e \"const fs=require('fs'); fs.mkdirSync('android/app/src/main/assets',{recursive:true});\" && react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "android:release": "npm run android:bundle && expo run:android --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "backend": "node backend/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "cors": "^2.8.5",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "~18.1.11",
    "expo-image-picker": "~16.1.4",
    "expo-local-authentication": "~16.0.5",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "react": "19.0.0",
    "react-native": "^0.79.6"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
