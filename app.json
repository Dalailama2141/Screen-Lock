{
  "expo": {
    "name": "Screen Guard",
    "slug": "screen-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "entryPoint": "./index.js",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.screenguard"
    },
    "plugins": [
      "./plugins/withInstalledApps",
      "expo-asset"
    ]
  }
}
